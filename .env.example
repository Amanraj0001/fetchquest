# Copy to .env; npm run server loads it. Never commit .env.
PORT=8000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
# Register and verify this address to grant initial administrator access.
ADMIN_EMAIL=
# Leave blank locally; a private runtime/phone.key is generated and persisted.
PHONE_ENCRYPTION_KEY=
MIN_ROUTE_SAMPLES=3
# Optional overrides: DATA_DIR=./runtime and FIELDWORK_CSV=./data.csv
# Production requires NODE_ENV=production, HTTPS APP_ORIGIN, a 64-hex encryption key,
# HOST=0.0.0.0, persistent DATA_DIR, and SMTP settings below.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
